--// Bottom navbar (with fade page transitions)
local function BuildNavBar(window,frame)
	local nav=Instance.new("Frame")
	nav.Name="Frame"
	nav.Position=UDim2.new(0,0,0.933025,0)
	nav.Size=UDim2.new(1,-1,0,30)
	nav.BackgroundColor3=colors.Stroke
	nav.BorderSizePixel=0
	nav.Parent=frame

	local icons={}

	local function makeIcon(name,image,xScale)
		local icon=Instance.new("ImageButton")
		icon.Name=name
		icon.Position=UDim2.new(xScale,0,0.146666,0)
		icon.Size=UDim2.new(0,20,0,20)
		icon.BackgroundTransparency=1
		icon.BorderSizePixel=0
		icon.Image=image
		icon.ImageColor3=colors.NavIdle
		icon.Parent=nav
		icons[name]=icon
		return icon
	end

	local homeIcon=makeIcon("home","rbxassetid://117906088481880",0.871838)
	local featuresIcon=makeIcon("features","rbxassetid://136217097965233",0.913997)
	local settingsIcon=makeIcon("settings","rbxassetid://135898386481523",0.954469)

	local pages={}
	local switching=false

	local function switchTo(pageName)
		if switching then return end
		if window.ActivePage==pageName then return end
		switching=true

		local current=pages[window.ActivePage]
		local target=pages[pageName]

		for name,icon in pairs(icons) do
			TweenService:Create(icon,bezierFast,{ImageColor3=(name==pageName) and colors.Text or colors.NavIdle}):Play()
		end

		window.Frame.Title.Visible=(pageName=="features")

		if current then
			local fadeOut=TweenService:Create(current,bezierFast,{GroupTransparency=1})
			fadeOut:Play()
			fadeOut.Completed:Connect(function()
				current.Visible=false
				target.Visible=true
				target.GroupTransparency=1
				local fadeIn=TweenService:Create(target,bezierFast,{GroupTransparency=0})
				fadeIn:Play()
				fadeIn.Completed:Connect(function()
					switching=false
				end)
			end)
		else
			target.Visible=true
			target.GroupTransparency=1
			local fadeIn=TweenService:Create(target,bezierFast,{GroupTransparency=0})
			fadeIn:Play()
			fadeIn.Completed:Connect(function()
				switching=false
			end)
		end

		window.ActivePage=pageName
	end

	homeIcon.MouseButton1Click:Connect(function() switchTo("home") end)
	featuresIcon.MouseButton1Click:Connect(function() switchTo("features") end)
	settingsIcon.MouseButton1Click:Connect(function() switchTo("settings") end)

	window.NavBar=nav
	window.NavIcons=icons
	window.NavPages=pages
	window.SwitchPage=switchTo

	return pages
end

